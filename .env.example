# ==============================================================================
# SPENDORA ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Frontend (Vite / React) - Safe to expose to browser
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:3001
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Backend (Node.js Express Server) - SECRETS: NEVER EXPOSE TO FRONTEND
PORT=3001
FRONTEND_URL=http://localhost:5173

# Supabase Server Admin Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail SMTP Configuration (Nodemailer)
# SENDER MUST BE: spendorafinancetracker@gmail.com
# IMPORTANT: Generate a 16-character Google App Password in your Google Account security settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=spendorafinancetracker@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM="Spendora <spendorafinancetracker@gmail.com>"

# Cryptographic OTP Secret (For HMAC-SHA256 Hashed Challenge Storage)
OTP_HASH_SECRET=spendora_super_secret_hmac_key_min_32_chars_long
